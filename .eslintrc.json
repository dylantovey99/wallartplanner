{
  "env": {
    "browser": true,
    "es2021": true,
    "node": false
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-console": "warn",
    "no-debugger": "error",
    "no-unused-vars": ["warn", {
      "argsIgnorePattern": "^_",
      "varsIgnorePattern": "^_"
    }],
    "no-undef": "error",
    "no-var": "error",
    "prefer-const": "warn",
    "prefer-arrow-callback": "warn",
    "arrow-spacing": "error",
    "comma-dangle": ["warn", "only-multiline"],
    "semi": ["error", "always"],
    "quotes": ["warn", "single", { "avoidEscape": true }],
    "indent": ["warn", 4, { "SwitchCase": 1 }],
    "max-len": ["warn", {
      "code": 120,
      "ignoreStrings": true,
      "ignoreTemplateLiterals": true,
      "ignoreComments": true
    }],
    "no-multiple-empty-lines": ["warn", { "max": 2 }],
    "eqeqeq": ["error", "always"],
    "curly": ["error", "all"],
    "brace-style": ["warn", "1tbs"],
    "space-before-blocks": "warn",
    "keyword-spacing": "warn",
    "no-trailing-spaces": "warn"
  },
  "globals": {
    "html2canvas": "readonly",
    "AWS": "readonly"
  }
}
